<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up or transferred. Paired devices are sealed with a key
    that lives in this phone's Keystore and never restores, so a copy would be
    unreadable; the TLS client key cannot leave the Keystore either.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
